# Database
# Pour le développement local : PostgreSQL (utiliser Neon, Railway, ou Docker)
# DATABASE_URL=postgresql://user:password@host:5432/orizon?schema=public

# Pour Neon (production) :
# 1. Crée un compte sur https://neon.tech
# 2. Crée un projet, copie la connection string
# 3. Configure-la dans les variables d'environnement Vercel
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/orizon?sslmode=require

# NextAuth Configuration (required for production)
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# NextAuth Configuration (required for production)
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Node Environment
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# LLM Provider (OpenAI-compatible)
# Décommentez et configurez selon votre provider préféré :
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Anciennes variables (encore supportées pour compatibilité)
# AIONLABS_API_KEY=alv2_...
# AIONLABS_BASE_URL=https://api.aionlabs.ai/v1
# AIONLABS_MODEL=aion-labs/aion-3.0
