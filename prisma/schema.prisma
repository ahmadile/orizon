// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ZCode models
// =========================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  conversations Conversation[]
}

model Repo {
  id          String   @id @default(cuid())
  name        String
  path        String   @unique
  description String?
  language    String?
  stars       Int      @default(0)
  forks       Int      @default(0)
  totalFiles  Int      @default(0)
  totalLines  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  conversations Conversation[]
}

model Conversation {
  id           String   @id @default(cuid())
  title        String
  phase        String   @default("comprehension")
  intent       String?
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repoId String?
  repo   Repo?   @relation(fields: [repoId], references: [id], onDelete: SetNull)

  messages Message[]
  comprehensionSteps ComprehensionStep[]

  @@index([repoId])
  @@index([userId])
}

model Message {
  id           String   @id @default(cuid())
  role         String   // "user" | "assistant" | "system"
  content      String
  reasoning    String?
  attachments  String?  // JSON string
  error        Boolean  @default(false)
  timestamp    DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ComprehensionStep {
  id             String   @id @default(cuid())
  stepKey        String   // "scan", "detect-stack", etc.
  label          String
  detail         String
  status         String   @default("pending") // "pending" | "running" | "completed" | "error"
  durationMs     Int      @default(1000)
  completedAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
